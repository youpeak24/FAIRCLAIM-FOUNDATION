# Contact form endpoint (Formspree, Basin, Web3Forms, or a custom HTTPS webhook).
# Read at BUILD time. Variables prefixed with VITE_ are public: never put secrets here.
# Leave empty to show the "enquiries not available yet" notice instead of the working form.
#
# Example:
# VITE_CONTACT_FORM_ENDPOINT="https://formspree.io/f/your_form_id"
VITE_CONTACT_FORM_ENDPOINT=
